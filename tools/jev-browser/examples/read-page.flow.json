{
  "schemaVersion": 1,
  "steps": [
    {
      "id": "goto",
      "kind": "action",
      "action": "navigate",
      "value": "https://example.com",
      "expect": [{ "kind": "url_contains", "value": "example.com" }]
    },
    {
      "id": "read-link",
      "kind": "extract",
      "target": { "by": "role", "role": "link", "name": "Learn more", "exact": true },
      "fields": ["text", "count"],
      "saveAs": "link"
    },
    {
      "id": "verify-link",
      "kind": "assert",
      "expect": [{ "kind": "var_equals", "variable": "link.text", "value": "Learn more" }]
    },
    {
      "id": "shot",
      "kind": "action",
      "action": "screenshot"
    }
  ],
  "values": {}
}
