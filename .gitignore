# ===== 环境配置（任何层级都不提交） =====
# 匹配任意层级的 .env 文件或目录
.env

# ===== 依赖目录（pnpm/npm install 可再生） =====
node_modules/

# ===== Python 字节码缓存（可再生） =====
__pycache__/
*.py[cod]

# ===== TypeScript 构建产物（pnpm build / tsc -b 可再生） =====
dist/
*.tsbuildinfo

# ===== npm 回退安装生成的锁文件 =====
# 主锁文件 pnpm-lock.yaml 已托管；npm 回退时的 package-lock.json 不托管，避免双锁冲突
package-lock.json

# ===== 日志与系统杂项 =====
*.log
.DS_Store
Thumbs.db
